# Copie para .env e preencha antes de rodar docker compose up

POSTGRES_PASSWORD=troque_esta_senha

# Precisa ter PELO MENOS 32 caracteres (senão o cadastro/login falha).
# Para gerar uma: openssl rand -base64 48
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=cole_sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-120b
